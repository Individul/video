# Copiază în /opt/vid/.env pe VPS și completează:  cp .env.vps.example .env && nano .env && chmod 600 .env

# domeniul îndreptat spre IP-ul VPS (DNS A record); Caddy ia singur certificatul HTTPS
DOMAIN=cinema.exemplu.ro

# parola portalului + secretul sesiunilor
#   secret nou: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
APP_SECRET=

# cheia TMDB (aceeași ca în .env-ul de acasă)
TMDB_API_KEY=

# cheia API Jackett (din interfața Jackett, colț dreapta-sus; rămâne aceeași dacă îi copiezi configul)
TORZNAB_API_KEY=

# opțional
# OS_API_KEY=            # OpenSubtitles, subtitrări RU externe
# PROXY=http://user:parola@host:port   # doar dacă Rutor/BTDig blochează IP-ul VPS-ului
# TZ=Europe/Chisinau
