{
	servers {
		# fără HTTP/3 (QUIC pe UDP): măsurat ~4 Mbit/s spre client, față de ~76 Mbit/s pe TCP —
		# prea puțin pentru video; HTTP/2 pe TCP merge la viteza completă
		protocols h1 h2
	}
}

# HTTPS automat (Let's Encrypt) pentru domeniul din .env (DOMAIN=cinema.exemplu.ro)
{$DOMAIN} {
	# stream-uri video: doar după login în portal; parola nu ajunge niciodată la TorrServer
	handle /ts/stream/* {
		forward_auth vid:8000 {
			# /api/health cere cookie-ul portalului: 200 = logat, 401 = refuzat
			uri /api/health
		}
		uri strip_prefix /ts
		reverse_proxy torrserver:8090 {
			flush_interval -1 # video fără buffering
		}
	}

	# segmentele video ale transmisiilor live (Ace Stream) — tot doar după login
	handle /ace/c/* {
		forward_auth vid:8000 {
			uri /api/health
		}
		reverse_proxy acestream:6878 {
			flush_interval -1
		}
	}

	# bibliotecă: Navidrome (muzică) primește utilizatorul de la portal, fără parolă proprie
	handle /music* {
		forward_auth vid:8000 {
			uri /api/health
		}
		reverse_proxy navidrome:4533 {
			header_up Remote-User cinema
			flush_interval -1
		}
	}
	# Audiobookshelf (cărți audio): după login-ul portalului; are și contul lui
	handle /audiobookshelf* {
		forward_auth vid:8000 {
			uri /api/health
		}
		reverse_proxy audiobookshelf:80 {
			flush_interval -1
		}
	}

	# restul TorrServer (interfața lui web) nu e accesibil din internet
	handle /ts/* {
		respond 404
	}

	handle {
		encode zstd gzip
		reverse_proxy vid:8000
	}
}
